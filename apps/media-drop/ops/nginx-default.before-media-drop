server {
    listen 443 ssl;
    server_name ritanai.cn www.ritanai.cn;
    ssl_certificate ritanai.cn_bundle.crt;
    ssl_certificate_key ritanai.cn.key;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5:!RC4:!DHE;
    ssl_prefer_server_ciphers on;

    # Redirect /cat-bridge.html to Chinese version
    location = /cat-bridge.html {
        return 301 /cat-bridge-china.html;
    }

    location /skin-diagnosis/ {
          alias /home/ubuntu/lanqiao/static/skin-diagnosis/;
          index index.html;
          try_files $uri $uri/ /skin-diagnosis/index.html;
      }

      location /picture/ {
          alias /home/ubuntu/lanqiao/static/picture/;
      }

      # 多模型 API 网关 — 飞书事件回调
      location /api/v1/feishu/ {
          proxy_pass http://127.0.0.1:8002/api/v1/feishu/;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      }

      location / {
          proxy_pass http://127.0.0.1:8000;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
      }
}

server {
    listen 443 ssl;
    server_name ritanai.com www.ritanai.com;
    include /etc/nginx/snippets/dfu-v2-test.conf;
    include /etc/nginx/snippets/dfu-collection.conf;
    ssl_certificate ritanai.com.pem;
    ssl_certificate_key ritanai.com.key;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5:!RC4:!DHE;
    ssl_prefer_server_ciphers on;

    location /skin-diagnosis/ {
        alias /home/ubuntu/lanqiao/static/skin-diagnosis/;
        index index.html;
        try_files $uri $uri/ /skin-diagnosis/index.html;
    }
    location /lanjiao-static/ {
        alias /home/ubuntu/lanqiao/static/;
        expires 30d;
    }
    location /mediapipe/ {
        alias /home/ubuntu/lanqiao/static/mediapipe/;
        expires 30d;
    }
    location /lanjiao/ {
        proxy_pass http://127.0.0.1:8001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /dfu/ {
        proxy_pass http://127.0.0.1:8003/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 20m;
    }
    # Redirect /cat-bridge.html to Chinese version
    location = /cat-bridge.html {
        return 301 /cat-bridge-china.html;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

